{
  "name": "zdravje-plus",
  "version": "0.1.7",
  "private": true,
  "description": "Mobilna zdravstvena aplikacija za študente in starejše (Capacitor)",
  "scripts": {
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/@capacitor/core/dist/capacitor.js','www/capacitor.js')\"",
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  },
  "engines": {
    "node": ">=22"
  }
}
